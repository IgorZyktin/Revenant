  ENEMIES "player,trainer,human,humanoid,beast,spider,supernatural,undead"
  CLASS "Revenant"
  BLOCK 25, 10, 12
  ATTACKFREQ 1, 30
  MAGICFREQ 50, 170
  WEAPONDAMAGE 12
  SIGHT 50, 100, 640, 64
  HEARING 50, 100, 640
  COMBATRANGE 160
  SWIPECOLOR 200, 0, 230
  MAXATTACKRANGE 150
  BLOCKSOUNDS "block1,block2"
  RUNFATIGUE 10, 100
  BOWWAIT 24


